# GitHub personal access token used server-side for the contribution graph.
# Create a classic or fine-grained token with the `read:user` scope and set
# this value on Vercel (Project > Settings > Environment Variables).
# Never commit a real token. This file is a placeholder reminder only.
GITHUB_TOKEN=

# GitHub login to fetch contributions for. Defaults to NaferJ.
GITHUB_USERNAME=NaferJ
